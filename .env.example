# Shared secret configured in the GitHub webhook settings. Required.
GITHUB_WEBHOOK_SECRET=change-me

# Bearer token for the admin API (/repos, /deployments, /status).
# Those routes return 503 until this is set.
ADMIN_TOKEN=change-me

# Where the checkouts live on the server.
PROJECTS_DIR=/srv/projects

# SQLite file holding the repository registry and deploy history.
DB_PATH=./data/deploy-server.db

# A push from an unknown repository registers itself, as long as
# PROJECTS_DIR/<name>/.git already exists. Set to false to require
# creating the repo through POST /repos first.
AUTO_REGISTER=true

# Bind to localhost and put a reverse proxy with TLS in front.
HOST=127.0.0.1
PORT=7777

# Hostname the bundled nginx serves and certbot requests the certificate for.
# It has to resolve to this server before scripts/init-letsencrypt.sh runs.
DOMAIN=deploy-server.example.com

# Where Let's Encrypt sends expiry warnings.
LETSENCRYPT_EMAIL=you@example.com

# 1 uses the Let's Encrypt staging CA: untrusted certificates, but generous
# rate limits. Test the setup there first, then set it back to 0 and rerun
# scripts/init-letsencrypt.sh.
CERTBOT_STAGING=0

# Kill a step that runs longer than this (ms).
STEP_TIMEOUT_MS=900000

# How much of each deploy log to keep, and how many deploys per repo.
LOG_TAIL_BYTES=65536
DEPLOYMENT_HISTORY=50
