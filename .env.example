# ---------------------------------------------------------------- required

# Shared secret configured in the GitHub webhook settings. Every delivery is
# HMAC-verified against it. Nimbus2k refuses to start without one.
GITHUB_WEBHOOK_SECRET=change-me

# The operator who signs in to the UI.
ADMIN_USER=admin

# Their password. At least 12 characters. Generate one with:
#   openssl rand -base64 24
ADMIN_PASSWORD=change-me-at-least-12-chars

# Preferred over ADMIN_PASSWORD: the scrypt digest of the same password, so a
# leaked .env does not hand over a credential a human may have reused. Generate
# it with `npm run hash-password`, put the result here and delete ADMIN_PASSWORD.
# When both are set, the hash wins.
# ADMIN_PASSWORD_HASH=scrypt$16384$8$1$...

# ---------------------------------------------------------------- optional

# Bearer token for machines calling /api/v1. At least 16 characters.
# Leave it unset to authenticate the API with ADMIN_USER / ADMIN_PASSWORD over
# HTTP Basic instead.
#   openssl rand -hex 32
# ADMIN_TOKEN=

# ---------------------------------------------------------------- storage

# Where the git checkouts live on the server.
PROJECTS_DIR=/srv/projects

# SQLite file holding the registry, deploy history, groups and the audit log.
# An existing data/nimbus.db or data/deploy-server.db is adopted on first start.
DB_PATH=./data/nimbus2k.db

# ---------------------------------------------------------------- http

# Bind to localhost and put a reverse proxy with TLS in front.
HOST=127.0.0.1
PORT=7777

# How many proxies sit in front. 1 is right for a single nginx or Caddy.
TRUST_PROXY=1

# How long a browser session lasts before it has to sign in again.
SESSION_TTL_MS=43200000

# ---------------------------------------------------------------- deploys

# A push from an unknown repository registers itself, as long as
# PROJECTS_DIR/<name>/.git already exists. Set to false to require creating the
# project through the UI or POST /api/v1/projects first.
AUTO_REGISTER=true

# Kill a deploy step that runs longer than this (ms).
STEP_TIMEOUT_MS=900000

# How much of each deploy log to keep, and how many runs per project.
LOG_TAIL_BYTES=65536
DEPLOYMENT_HISTORY=50

# ---------------------------------------------------------------- fleet

# Start, stop, restart and pause containers from the fleet view.
# false makes the whole fleet view strictly read-only.
CONTAINER_ACTIONS=true

# kill, remove and prune. Off by default: these cannot be undone from the UI.
CONTAINER_DESTRUCTIVE_ACTIONS=false

# `docker stats` costs a round trip per container, so one sample is reused for
# this long across every request.
DOCKER_STATS_TTL_MS=4000
DOCKER_PS_TTL_MS=1500

# Lines of container output loaded when a container page opens.
DOCKER_LOG_TAIL=500

# ---------------------------------------------------------------- branding

# Shown in the sidebar, the page title and the login card.
APP_NAME=Nimbus2k
APP_TAGLINE=deployment control plane

# debug | info | warn | error
LOG_LEVEL=info
