# Everything here is optional.
#
# Nimbus2k starts with no .env at all: on the first run it generates an admin
# password and a webhook secret, prints them once, and stores them hashed (the
# password) beside the database. Both are shown again under Settings.
#
# Copy this file to .env only to override something.

# ---------------------------------------------------------------- sign-in

# ADMIN_USER=admin

# Set this to choose your own password instead of the generated one. It is
# hashed with scrypt on the next boot and stored as a digest, after which this
# line can be deleted — the password keeps working. At least 12 characters.
# ADMIN_PASSWORD=

# Already have a digest? Put it here and it wins over everything above.
# ADMIN_PASSWORD_HASH=scrypt$16384$8$1$...

# Bearer token for machines calling /api/v1, at least 16 characters. Without
# one the API accepts ADMIN_USER / password over HTTP Basic.
# ADMIN_TOKEN=

# ---------------------------------------------------------------- github

# Shared secret for the webhook. Generated and shown under Settings when unset.
# GITHUB_WEBHOOK_SECRET=

# ---------------------------------------------------------------- paths

# PROJECTS_DIR=/srv/projects
# DB_PATH=./data/nimbus2k.db

# ---------------------------------------------------------------- http

# Bind to localhost and put a reverse proxy with TLS in front.
# HOST=127.0.0.1
# PORT=3000
# TRUST_PROXY=1
# SESSION_TTL_MS=43200000

# ---------------------------------------------------------------- deploys

# AUTO_REGISTER=true
# STEP_TIMEOUT_MS=900000
# LOG_TAIL_BYTES=65536
# DEPLOYMENT_HISTORY=50

# ---------------------------------------------------------------- fleet

# Start, stop, restart and pause containers from the UI.
# CONTAINER_ACTIONS=true

# kill, remove and prune. Off by default: these cannot be undone.
# CONTAINER_DESTRUCTIVE_ACTIONS=false

# DOCKER_STATS_TTL_MS=4000
# DOCKER_PS_TTL_MS=1500
# DOCKER_LOG_TAIL=500

# ---------------------------------------------------------------- misc

# APP_NAME=Nimbus2k
# APP_TAGLINE=deployment control plane
# LOG_LEVEL=info
