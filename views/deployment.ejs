<%- include("partials/head", { title: title }) %>

<p class="crumb">
    <a href="/ui">dashboard</a> /
    <a href="/ui/repos/<%= encodeURIComponent(deployment.repo) %>"><%= deployment.repo %></a> /
    #<%= deployment.id %>
</p>

<div class="card">
    <div class="card-head">
        <h1>
            #<%= deployment.id %>
            <span class="status <%= deployment.status %>" id="deploy-status">
                <% if (deployment.status === "running") { %><span class="pulse"></span><% } %><%= deployment.status %>
            </span>
        </h1>

        <% if (deployment.status === "running") { %>
        <form method="post" action="/ui/repos/<%= encodeURIComponent(deployment.repo) %>/cancel">
            <input type="hidden" name="back" value="/ui/deployments/<%= deployment.id %>">
            <button class="danger" type="submit" data-confirm="Cancel the running deploy?">Cancel</button>
        </form>
        <% } else { %>
        <form method="post" action="/ui/deployments/<%= deployment.id %>/redeploy">
            <button class="ghost" type="submit" data-confirm="Deploy <%= deployment.branch %> again?">Redeploy</button>
        </form>
        <% } %>
    </div>

    <dl class="meta">
        <dt>Repo</dt><dd><a href="/ui/repos/<%= encodeURIComponent(deployment.repo) %>"><%= deployment.repo %></a></dd>
        <dt>Branch</dt><dd><code><%= deployment.branch %></code></dd>
        <dt>Commit</dt><dd><code><%= deployment.commit_sha || "-" %></code></dd>
        <dt>Trigger</dt><dd><%= deployment.trigger %></dd>
        <dt>Started</dt><dd><%= fmt.stamp(deployment.started_at) %></dd>
        <dt>Finished</dt><dd><%= fmt.stamp(deployment.finished_at) %></dd>
        <dt>Took</dt><dd><%= fmt.duration(deployment.duration_ms) %></dd>
    </dl>

    <% if (deployment.error) { %>
    <p class="error"><%= deployment.error %></p>
    <% } %>
</div>

<div class="card">
    <div class="card-head">
        <h2>Log</h2>
        <div class="log-tools">
            <% if (deployment.status === "running") { %>
            <label class="check inline">
                <input type="checkbox" id="follow" checked>
                <span>follow</span>
            </label>
            <% } %>
            <a class="ghost-link" href="/ui/deployments/<%= deployment.id %>/raw" target="_blank" rel="noopener">raw</a>
        </div>
    </div>

    <pre class="log" id="log"
         data-deployment="<%= deployment.id %>"
         data-live="<%= deployment.status === "running" ? "1" : "" %>"><%= log || "(empty)" %></pre>
</div>

<%- include("partials/foot") %>
