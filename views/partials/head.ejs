<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="dark light">
    <meta name="robots" content="noindex, nofollow">
    <title><%= title %> · <%= app.name %></title>

    <link rel="stylesheet" href="/assets/css/tokens.css">
    <link rel="stylesheet" href="/assets/css/base.css">
    <link rel="stylesheet" href="/assets/css/layout.css">
    <link rel="stylesheet" href="/assets/css/components.css">
    <link rel="stylesheet" href="/assets/css/pages.css">

    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">

    <%# Runs before the first paint so a stored theme never flashes the other one. %>
    <script src="/assets/js/theme.js"></script>
</head>
<body>
<%- include("icons") %>

<div class="shell" data-collapsed="0">
    <%- include("sidebar", { nav: nav }) %>

    <div class="main">
        <%- include("topbar", { title: title, crumbs: typeof crumbs === "undefined" ? null : crumbs }) %>

        <div class="toasts" aria-live="polite">
            <% if (flash) { %>
            <div class="toast <%= flash.tone %>" data-flash role="status">
                <svg class="i" aria-hidden="true"><use href="#i-<%= flash.tone === "ok" ? "check-circle" : flash.tone === "bad" ? "alert-circle" : flash.tone === "warn" ? "alert-triangle" : "info" %>"></use></svg>
                <span><%= flash.text %></span>
            </div>
            <% } %>
        </div>

        <main class="page">
