        </main>
    </div>
</div>

<div class="palette-backdrop" id="palette" hidden>
    <div class="palette" role="dialog" aria-modal="true" aria-label="Command palette">
        <div class="palette-input">
            <svg class="i lg" aria-hidden="true"><use href="#i-search"></use></svg>
            <label class="sr-only" for="palette-input">Search projects, containers and pages</label>
            <input type="text" id="palette-input" autocomplete="off" spellcheck="false"
                   placeholder="Search projects, containers, stacks and pages…">
        </div>

        <div class="palette-results" id="palette-results" role="listbox"></div>

        <div class="palette-foot">
            <span><kbd>↑</kbd><kbd>↓</kbd> move</span>
            <span><kbd>↵</kbd> open</span>
            <span><kbd>esc</kbd> close</span>
            <span style="margin-left:auto"><kbd>/</kbd> filter on page</span>
        </div>
    </div>
</div>

<script src="/assets/js/app.js" defer></script>
</body>
</html>
