<aside class="sidebar">
    <a class="brand" href="/ui" aria-label="<%= app.name %> home">
        <span class="brand-mark"><svg class="i" aria-hidden="true"><use href="#i-cloud"></use></svg></span>
        <span class="brand-text">
            <span class="brand-name"><%= app.name %></span>
            <span class="brand-sub"><%= app.tagline %></span>
        </span>
    </a>

    <nav class="nav" aria-label="Primary">
        <% navItems.forEach(function (item) { %>
        <a class="nav-link"
           href="<%= item.href %>"
           data-label="<%= item.label %>"
           <%= nav === item.id ? 'aria-current="page"' : "" %>>
            <svg class="i" aria-hidden="true"><use href="#i-<%= item.icon %>"></use></svg>
            <span class="nav-label"><%= item.label %></span>
        </a>
        <% }) %>
    </nav>

    <div class="sidebar-foot">
        <button class="nav-link" type="button" id="sidebar-collapse" data-label="Collapse sidebar">
            <svg class="i" aria-hidden="true"><use href="#i-panel"></use></svg>
            <span class="nav-label">Collapse</span>
        </button>

        <div class="sidebar-meta">
            <span>v<%= app.version %></span>
            <span><%= app.env === "production" ? "prod" : app.env %></span>
        </div>
    </div>
</aside>
