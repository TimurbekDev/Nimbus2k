<%- include("partials/head", { title: "Log in", session: false }) %>

<form class="card login" method="post" action="/ui/login">
    <h1>Log in</h1>
    <p class="muted">Paste the value of <code>ADMIN_TOKEN</code>.</p>

    <% if (error) { %>
    <p class="error"><%= error %></p>
    <% } %>

    <input type="password" name="token" autocomplete="off" autofocus
           placeholder="admin token" <%= configured ? "" : "disabled" %>>

    <button type="submit" <%= configured ? "" : "disabled" %>>Log in</button>

    <% if (!configured) { %>
    <p class="error">ADMIN_TOKEN is not set on the server.</p>
    <% } %>
</form>

<%- include("partials/foot") %>
