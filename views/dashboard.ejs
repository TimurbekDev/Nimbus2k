<%- include("partials/head", { title: title }) %>

<div class="tiles">
    <div class="tile">
        <span class="tile-value"><%= repos.length %></span>
        <span class="tile-label">repositories</span>
    </div>
    <div class="tile">
        <span class="tile-value"><%= fmt.percent(stats.success, stats.total) %></span>
        <span class="tile-label"><%= stats.success %>/<%= stats.total %> succeeded</span>
    </div>
    <div class="tile">
        <span class="tile-value"><%= fmt.duration(stats.averageMs) %></span>
        <span class="tile-label">average deploy</span>
    </div>
    <div class="tile <%= active.length > 0 ? "hot" : "" %>">
        <span class="tile-value"><%= active.length %></span>
        <span class="tile-label">running now</span>
    </div>
</div>

<% if (active.length > 0) { %>
<div class="card live">
    <h2>Deploying now</h2>
    <ul class="live-list">
        <% active.forEach(function (item) { %>
        <li>
            <span class="pulse"></span>
            <a href="/ui/repos/<%= encodeURIComponent(item.repo) %>"><%= item.repo %></a>
            <a class="muted" href="/ui/deployments/<%= item.id %>">watch log →</a>
        </li>
        <% }) %>
    </ul>
</div>
<% } %>

<div class="card">
    <div class="card-head">
        <h2>Repositories <span class="count"><%= repos.length %></span></h2>
        <input class="filter" type="search" id="repo-filter" placeholder="filter…  (press /)" autocomplete="off">
    </div>

    <% if (repos.length === 0) { %>
    <p class="muted">Nothing registered yet. A push from a repository with a
        checkout under <code><%= projectsDir %></code> registers itself.</p>
    <% } else { %>
    <table class="filterable">
        <thead>
        <tr><th>Name</th><th>Branch</th><th>Last deploy</th><th>Flags</th><th></th></tr>
        </thead>
        <tbody>
        <% repos.forEach(function (repo) { %>
        <tr data-name="<%= repo.name %>">
            <td>
                <a href="/ui/repos/<%= encodeURIComponent(repo.name) %>"><%= repo.name %></a>
                <% if (!repo.enabled) { %><span class="tag off">disabled</span><% } %>
                <% if (activeNames.includes(repo.name)) { %><span class="tag live"><span class="pulse"></span>running</span><% } %>
                <div class="path"><%= repo.path %></div>
            </td>
            <td><code><%= repo.branch %></code></td>
            <td>
                <% if (repo.last_id) { %>
                <a href="/ui/deployments/<%= repo.last_id %>">
                    <span class="status <%= repo.last_status %>"><%= repo.last_status %></span>
                </a>
                <time datetime="<%= fmt.iso(repo.last_started_at) %>" data-ago><%= fmt.ago(repo.last_started_at) %></time>
                <% } else { %>
                <span class="muted">never</span>
                <% } %>
            </td>
            <td class="muted flags">
                <% if (repo.prune_images) { %><span class="tag">prune</span><% } %>
                <% if (repo.clean_untracked) { %><span class="tag warn">clean</span><% } %>
                <% if (repo.compose_file) { %><span class="tag"><%= repo.compose_file %></span><% } %>
            </td>
            <td class="right">
                <% if (activeNames.includes(repo.name)) { %>
                <form method="post" action="/ui/repos/<%= encodeURIComponent(repo.name) %>/cancel">
                    <input type="hidden" name="back" value="/ui">
                    <button class="danger" type="submit" data-confirm="Cancel the running deploy?">Cancel</button>
                </form>
                <% } else { %>
                <form method="post" action="/ui/repos/<%= encodeURIComponent(repo.name) %>/deploy">
                    <input type="hidden" name="back" value="/ui">
                    <button type="submit" <%= repo.enabled ? "" : "disabled" %>>Deploy</button>
                </form>
                <% } %>
            </td>
        </tr>
        <% }) %>
        </tbody>
    </table>
    <p class="empty-filter muted" hidden>Nothing matches that filter.</p>
    <% } %>

    <details class="add">
        <summary>Register a repository by hand</summary>
        <p class="muted">Only needed when <code>AUTO_REGISTER</code> is off, or when the
            checkout lives outside <code><%= projectsDir %></code>. The name has to match the
            GitHub repository name exactly.</p>
        <form class="grid" method="post" action="/ui/repos">
            <label>Name <input type="text" name="name" placeholder="my-app" autocomplete="off" required></label>
            <label>Branch <input type="text" name="branch" placeholder="main" autocomplete="off"></label>
            <label>Checkout path <input type="text" name="path" placeholder="<%= projectsDir %>/my-app" autocomplete="off"></label>
            <button type="submit">Register</button>
        </form>
    </details>
</div>

<div class="card">
    <h2>Recent deploys</h2>

    <% if (recent.length === 0) { %>
    <p class="muted">No deploys recorded yet.</p>
    <% } else { %>
    <table>
        <thead>
        <tr><th>#</th><th>Repo</th><th>Branch</th><th>Commit</th><th>Trigger</th>
            <th>Status</th><th>Started</th><th>Took</th></tr>
        </thead>
        <tbody>
        <% recent.forEach(function (item) { %>
        <tr>
            <td><a href="/ui/deployments/<%= item.id %>">#<%= item.id %></a></td>
            <td><a href="/ui/repos/<%= encodeURIComponent(item.repo) %>"><%= item.repo %></a></td>
            <td><code><%= item.branch %></code></td>
            <td><code><%= fmt.sha(item.commit_sha) %></code></td>
            <td class="muted"><%= item.trigger %></td>
            <td><span class="status <%= item.status %>"><%= item.status %></span></td>
            <td><time datetime="<%= fmt.iso(item.started_at) %>" data-ago title="<%= fmt.stamp(item.started_at) %>"><%= fmt.ago(item.started_at) %></time></td>
            <td><%= fmt.duration(item.duration_ms) %></td>
        </tr>
        <% }) %>
        </tbody>
    </table>
    <% } %>
</div>

<%- include("partials/foot") %>
