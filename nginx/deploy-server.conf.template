# Installed into the host nginx by scripts/setup-nginx-tls.sh, which fills in
# __DOMAIN__ and __PORT__. Do not symlink this file into /etc/nginx: the deploy
# workflow runs `git checkout -- .`, so anything written back here is lost.

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # Renewals re-use this path, so it has to stay reachable over plain HTTP.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    # The `http2 on;` directive only exists from 1.25.1; this form works from
    # 1.9.5 onwards and merely logs a deprecation notice on newer builds.
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __DOMAIN__;

    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000" always;

    # The webhook payload cap in app.js is 1mb; anything larger is rejected
    # here instead of travelling to the app.
    client_max_body_size 1m;

    access_log /var/log/nginx/deploy-server.access.log;
    error_log  /var/log/nginx/deploy-server.error.log;

    location / {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # A deploy is scheduled, not awaited, so responses are fast; the
        # timeout only has to cover the app being busy.
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}
