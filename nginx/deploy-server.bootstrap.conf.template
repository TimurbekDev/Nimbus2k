# Serves only the ACME challenge. nginx will not start while ssl_certificate
# points at a file that does not exist yet, so this vhost stands in until the
# first certificate is issued and setup-nginx-tls.sh swaps in the real one.

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 503;
    }
}
